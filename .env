# ── API URL ───────────────────────────────────────────────────────────────────
# LOCAL DEV  → use local backend (avoids CORS issues with Cloudflare)
VITE_API_URL=http://localhost:5001/api

# PRODUCTION → uncomment when building for deployment (npm run build)
# VITE_API_URL=https://erp.majesticmall.net/api

# RENDER cloud backend → uncomment when testing against Render
# VITE_API_URL=https://chakraindustries-backend.onrender.com/api
